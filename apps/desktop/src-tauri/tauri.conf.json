{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coralogix Lens",
  "version": "0.1.0",
  "identifier": "com.coralogix.lens",
  "build": {
    "frontendDist": "../../../packages/ui/dist",
    "beforeBuildCommand": "npm --prefix ../.. run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Telemetry Health & Value Review",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../../../packages/api/dist": "server/api",
      "../../../packages/core/dist": "server/core",
      "../../../packages/connectors/dist": "server/connectors",
      "../../../packages/rules": "server/rules",
      "../../../packages/ui/dist": "server/ui",
      "../../../fixtures/demo.json": "server/demo.json",
      "../../../skills": "server/skills"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}