 opentelemetry-gateway:
   enabled: false
+  presets:
+    reduceResourceAttributes: *cx_reduce_resource_attributes
+  config:
+    processors:
+      tail_sampling:
+        # Coralogix Lens SPAN-3: Composite tail sampling (errors, slow, sampled healthy traffic) (source: https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/tailsamplingprocessor)
+        decision_wait: 10s
+        num_traces: 50000
+        policies:
+          - name: keep-critical-errors-100pct
+            type: and
+            and:
+              and_sub_policy:
+                - name: svc
+                  type: string_attribute
+                  string_attribute:
+                    key: service.name
+                    values:
+                      - checkout
+                      - payment
+                - name: err
+                  type: status_code
+                  status_code:
+                    status_codes:
+                      - ERROR
+          - name: keep-errors-1pct
+            type: and
+            and:
+              and_sub_policy:
+                - name: err
+                  type: status_code
+                  status_code:
+                    status_codes:
+                      - ERROR
+                - name: prob
+                  type: probabilistic
+                  probabilistic:
+                    sampling_percentage: 1
+          - name: keep-slow
+            type: latency
+            latency:
+              threshold_ms: 500
+          - name: keep-nonerror-1pct
+            type: and
+            and:
+              and_sub_policy:
+                - name: nonerror
+                  type: status_code
+                  status_code:
+                    status_codes:
+                      - OK
+                      - UNSET
+                - name: prob
+                  type: probabilistic
+                  probabilistic:
+                    sampling_percentage: 1
+    service:
+      pipelines:
+        traces:
+          processors:
+            # Coralogix Lens: the chart adds its preset processors to this list. Run `helm template` to confirm the final order before deploying.
+            - tail_sampling
 
